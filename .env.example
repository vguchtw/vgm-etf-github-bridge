# Required repository. Use either HTTPS + GITHUB_TOKEN or SSH.
GITHUB_REPOSITORY=vguchtw/vgm-etf-committee
GITHUB_BRANCH=main
GITHUB_AUTH_MODE=https
GITHUB_TOKEN=
GIT_AUTHOR_NAME=VGM ETF Bridge
GIT_AUTHOR_EMAIL=automation@vgm-consultancy.be

# Persistent location on vgm-server. /opt is synced to the Synology/Google Drive.
HOST_DATA_DIR=/opt/vgm-etf-bridge
HOST_SSH_DIR=/home/vgm-consultancy/.ssh

# historical | live_simulation | live
VGM_MODE=historical

# The container checks GitHub periodically. It does not advance until a valid decision exists.
POLL_SECONDS=60

# Hard safety gate. Keep false for historical and paper simulation.
ENABLE_LIVE_TRADING=false
